            "body": {
              "mode": "raw",
              "raw": "{\n  \"petTypeId\": \"{{petTypeId}}\",\n  \"breedId\": \"{{breedId}}\",\n  \"name\": \"Rosy\",\n  \"birthDate\": \"2024-05-10\",\n  \"weightKg\": 27.4,\n  \"heightCm\": 56,\n  \"gender\": \"Female\",\n  \"bloodType\": null,\n  \"personality\": \"Friendly, playful, intelligent and loves spending time with her family\",\n  \"profileImageUrl\": null\n}",
